COMPOSE_PROJECT_NAME=bomcurriculo

POSTGRES_DB=atsdatabase
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_PORT=5434

REDIS_PORT=6379

BACKEND_PORT=9000
FRONTEND_PORT=5173
BOT_PORT=8000

# Docker-internal Ollama endpoint used by Laravel and the legacy bot. The model is
# downloaded automatically into the ollama_data volume on first startup.
OLLAMA_IMAGE=ollama/ollama:0.33.3
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_REASONING=false
OLLAMA_NUM_PREDICT=2048

# The bot stops inference first, Laravel has time to receive its structured
# error, and Nginx remains the outermost timeout in the request chain.
BOT_INFERENCE_DEADLINE_SECONDS=240
BOT_URL=http://bot:8000
BOT_CONNECT_TIMEOUT_SECONDS=5
BOT_HEALTH_TIMEOUT_SECONDS=5
BOT_TIMEOUT_SECONDS=260

# Phase 1: Python prepares documents; Laravel calls Ollama directly.
# Set python to explicitly restore legacy inference (including its provider chain).
RESUME_GENERATION_DRIVER=ollama
RESUME_OUTPUT_LANGUAGE=pt-BR
RESUME_PREPARE_TIMEOUT_SECONDS=30
RESUME_MAX_SOURCE_CHARACTERS=30000
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=5m
