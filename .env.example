COMPOSE_PROJECT_NAME=bomcurriculo

POSTGRES_DB=atsdatabase
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_PORT=5434

REDIS_PORT=6379

BACKEND_PORT=9000
FRONTEND_PORT=5173

# Docker-internal Ollama endpoint used by Laravel. The model is
# downloaded automatically into the ollama_data volume on first startup.
OLLAMA_IMAGE=ollama/ollama:0.33.3
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_PREDICT=2048

# Native extraction and enrichment, followed by one Ollama request.
RESUME_OUTPUT_LANGUAGE=pt-BR
RESUME_DOCUMENT_TIMEOUT_SECONDS=10
GITHUB_TIMEOUT_SECONDS=10
RESUME_MAX_SOURCE_CHARACTERS=30000
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=5m
