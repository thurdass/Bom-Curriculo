APP_NAME="Bom Curriculo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9000

L5_SWAGGER_CONST_HOST=http://localhost:9000/api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=atsdatabase
DB_USERNAME=ats
DB_PASSWORD=ats

FIREBASE_MOBILE_PROJECT_ID=
FIREBASE_MOBILE_CLIENT_EMAIL=
FIREBASE_MOBILE_PRIVATE_KEY=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Native PDF/DOCX extraction and optional public GitHub enrichment.
PDFTOTEXT_BINARY=/usr/bin/pdftotext
RESUME_DOCUMENT_TIMEOUT_SECONDS=10
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=10

# Direct host default; Docker Compose uses http://ollama:11434.
RESUME_OUTPUT_LANGUAGE=pt-BR
RESUME_MAX_SOURCE_CHARACTERS=30000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=2048
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=5m
