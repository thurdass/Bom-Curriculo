# Secrets and deployment-specific overrides. Other non-secret configuration
# (timeouts, provider chain, ...) lives in config.yaml.

GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional. Raises GitHub's unauthenticated REST API rate limit (60
# requests/hour per IP) to 5000/hour when set. Used to enrich the resume with
# the user's verified GitHub profile/repos when a github_url is given — works
# fine without it, just at the lower unauthenticated limit.
GITHUB_TOKEN=

# Optional operational overrides of config.yaml, useful for per-environment
# deploys without editing the committed file.
IA_PROVIDER=auto
IA_PROVIDER_CHAIN=groq,gemini,deepseek,openai,ollama
USAR_IA_PADRAO=false
LOG_LEVEL=INFO

# Defaults for running the bot directly on the host. Docker Compose overrides
# the URL with http://ollama:11434 so it never targets its own container.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_REASONING=false
OLLAMA_NUM_PREDICT=2048
BOT_INFERENCE_DEADLINE_SECONDS=240
